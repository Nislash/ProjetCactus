[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]

linux.debug.x86_64 =     "res://../rust/target/debug/libcactus_native.so"
linux.release.x86_64 =   "res://../rust/target/release/libcactus_native.so"

windows.debug.x86_64 =   "res://../rust/target/debug/cactus_native.dll"
windows.release.x86_64 = "res://../rust/target/release/cactus_native.dll"

macos.debug =            "res://../rust/target/debug/libcactus_native.dylib"
macos.release =          "res://../rust/target/release/libcactus_native.dylib"
macos.debug.arm64 =      "res://../rust/target/debug/libcactus_native.dylib"
macos.release.arm64 =    "res://../rust/target/release/libcactus_native.dylib"
