; Engine configuration file.
; Édité initialement à la main lors du M0 — par la suite, éditer via l'éditeur
; Godot uniquement et commiter dans des PR isolées (cf CLAUDE.md zones partagées).
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjetCactus"
config/description="FPS roguelike/puzzle coop local 1-4 joueurs en split-screen, manettes USB uniquement."
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://scenes/ui/lobby/lobby.tscn"

[autoload]

InputRouter="*res://autoload/input_router.gd"
PlayerManager="*res://autoload/player_manager.gd"
RunState="*res://autoload/run_state.gd"

