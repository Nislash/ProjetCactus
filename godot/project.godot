[physics]

3d/default_gravity=20.0

[rendering]

; Requis par l'export macOS, qui refuse de produire un binaire universel ou
; x86_64 sans ce format. Coût : les textures sont importées dans une variante
; supplémentaire.
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.08, 1)
