[resource]
; Le dallage du tablier du pont, et rien d'autre.
;
; TRIPLANAIRE EN REPÈRE MONDE. La géométrie est faite de boîtes et de cylindres
; construits à l'exécution : ils n'ont pas d'UV exploitables, et un placage UV
; laisserait une couture à chaque arête. Le triplanaire projette selon les trois
; axes et supprime la question. En repère MONDE plutôt que local, pour que la
; terrasse et le donjon qui se touchent partagent le même appareillage au lieu
; de se décaler l'un par rapport à l'autre.
;
; uv1_scale = 0.22 : la texture se répète tous les 4.5 m. Choisi pour que les
; blocs se lisent à hauteur d'homme — plus grand, ils deviennent un motif ; plus
; petit, une texture de sol vue de trop loin.
albedo_color = Color(1, 1, 1, 1)
albedo_texture = ExtResource("1_albedo")
metallic = 0.0
roughness = 1.0
roughness_texture = ExtResource("3_rough")
roughness_texture_channel = 0
normal_enabled = true
normal_scale = 1.1
normal_texture = ExtResource("2_normal")
uv1_scale = Vector3(0.22, 0.22, 0.22)
uv1_triplanar = true
uv1_world_triplanar = true
texture_filter = 4
