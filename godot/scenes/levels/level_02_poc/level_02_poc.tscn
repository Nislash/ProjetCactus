[gd_scene load_steps=31 format=3 uid="uid://level_02_poc_m2"]

; Level 02 POC — block-out 3 étages :
;
;          [Coursive en U, Y=4]
;            ┌────────────────┐
;            │                │
;            │    [RDC]       │ ← escalier Est (RDC ↔ coursive)
;            │   spawn 4j     │
;            │   2 ennemis    │
;            └────────────────┘
;                   │
;                escalier Sud
;                   ↓
;            [Sous-sol Y=-4]
;            salle calme (futur loot/shop)
;
; Les ennemis ranged sont sur la coursive (vue plongeante sur le RDC).
; Les ennemis mêlée sont au RDC. Sous-sol vide pour l'instant.

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_horizon_color = Color(0.55, 0.45, 0.65, 1)
ground_horizon_color = Color(0.25, 0.2, 0.3, 1)

[sub_resource type="Sky" id="Sky_lvl2"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env_lvl2"]
background_mode = 2
sky = SubResource("Sky_lvl2")
ambient_light_source = 3
ambient_light_color = Color(0.4, 0.42, 0.55, 1)
ambient_light_energy = 0.5
tonemap_mode = 2

