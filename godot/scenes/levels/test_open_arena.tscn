[gd_scene load_steps=15 format=3 uid="uid://test_open_arena_m1"]

; ============================================================
; Test Open Arena — niveau M1 alternatif au level_01_poc
;
; - Zone rectangulaire 50×50 fermée (murs hauts 6m sur les 4 côtés)
; - Obstacles internes : 2 piliers + 2 murs courts pour casser les LDS
; - 4 spawn points joueurs regroupés sur le côté sud (z=-20)
; - 12 spawn points ennemis répartis : 6 mêlée (B*) + 6 ranged (C*)
;
; Conventions EnemySpawner :
; - Markers "EnemyC*" → ennemi ranged
; - Markers "EnemyB*" → ennemi mêlée
; ============================================================

; ─── Shapes & meshes ─────────────────────────────────────────
[sub_resource type="BoxShape3D" id="sha_floor"]
size = Vector3(50, 0.5, 50)

[sub_resource type="BoxMesh" id="msh_floor"]
size = Vector3(50, 0.5, 50)

[sub_resource type="BoxShape3D" id="sha_wall_ns"]
size = Vector3(50, 6, 1)

[sub_resource type="BoxMesh" id="msh_wall_ns"]
size = Vector3(50, 6, 1)

[sub_resource type="BoxShape3D" id="sha_wall_ew"]
size = Vector3(1, 6, 50)

[sub_resource type="BoxMesh" id="msh_wall_ew"]
size = Vector3(1, 6, 50)

[sub_resource type="BoxShape3D" id="sha_pillar"]
size = Vector3(2, 4, 2)

[sub_resource type="BoxMesh" id="msh_pillar"]
size = Vector3(2, 4, 2)

[sub_resource type="BoxShape3D" id="sha_short_wall"]
size = Vector3(8, 3, 0.5)

[sub_resource type="BoxMesh" id="msh_short_wall"]
size = Vector3(8, 3, 0.5)

; ─── Lighting ────────────────────────────────────────────────
[sub_resource type="ProceduralSkyMaterial" id="sky_mat"]
sky_horizon_color = Color(0.65, 0.72, 0.85, 1)
ground_horizon_color = Color(0.4, 0.45, 0.5, 1)

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_mat")

[sub_resource type="Environment" id="env"]
background_mode = 2
sky = SubResource("sky")
ambient_light_source = 3
ambient_light_energy = 0.35
tonemap_mode = 2

