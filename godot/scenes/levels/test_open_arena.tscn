[gd_scene load_steps=22 format=3 uid="uid://test_open_arena_m1"]

; ============================================================
; Test Open Arena — niveau M1 alternatif au level_01_poc
;
; Layout :
;   - Arène totale 70×70 (de -35 à +35 sur X et Z), fermée par 4 murs hauts.
;   - Salle centrale 40×40 (de -20 à +20) entourée de murs intérieurs avec
;     1 ouverture de 6m au centre de chaque côté (N/S/E/W).
;   - Couloirs périphériques de ~15m de large entre la salle centrale et
;     les murs extérieurs → permet de contourner / flanquer.
;
; Obstacles internes (dans la salle centrale) : 2 piliers + 2 murs courts.
;
; Spawn joueurs : couloir sud (4 markers).
; Spawn ennemis (12) : 6 dans la salle centrale + 6 dans les couloirs.
;
; Conventions EnemySpawner : "EnemyB*" → mêlée, "EnemyC*" → ranged.
; ============================================================

; ─── Shapes & meshes ─────────────────────────────────────────
[sub_resource type="BoxShape3D" id="sha_floor"]
size = Vector3(70, 0.5, 70)

[sub_resource type="BoxMesh" id="msh_floor"]
size = Vector3(70, 0.5, 70)

; Murs extérieurs périphérie 70×70
[sub_resource type="BoxShape3D" id="sha_wall_outer_ns"]
size = Vector3(70, 6, 1)

[sub_resource type="BoxMesh" id="msh_wall_outer_ns"]
size = Vector3(70, 6, 1)

[sub_resource type="BoxShape3D" id="sha_wall_outer_ew"]
size = Vector3(1, 6, 70)

[sub_resource type="BoxMesh" id="msh_wall_outer_ew"]
size = Vector3(1, 6, 70)

; Murs intérieurs de la salle centrale : 17m de long chacun (40 - 6 ouverture / 2)
[sub_resource type="BoxShape3D" id="sha_wall_inner_ns"]
size = Vector3(17, 4, 0.5)

[sub_resource type="BoxMesh" id="msh_wall_inner_ns"]
size = Vector3(17, 4, 0.5)

[sub_resource type="BoxShape3D" id="sha_wall_inner_ew"]
size = Vector3(0.5, 4, 17)

[sub_resource type="BoxMesh" id="msh_wall_inner_ew"]
size = Vector3(0.5, 4, 17)

; Obstacles internes
[sub_resource type="BoxShape3D" id="sha_pillar"]
size = Vector3(2, 4, 2)

[sub_resource type="BoxMesh" id="msh_pillar"]
size = Vector3(2, 4, 2)

[sub_resource type="BoxShape3D" id="sha_short_wall"]
size = Vector3(8, 3, 0.5)

[sub_resource type="BoxMesh" id="msh_short_wall"]
size = Vector3(8, 3, 0.5)

; ─── Lighting ────────────────────────────────────────────────
[sub_resource type="ProceduralSkyMaterial" id="sky_mat"]
sky_horizon_color = Color(0.65, 0.72, 0.85, 1)
ground_horizon_color = Color(0.4, 0.45, 0.5, 1)

[sub_resource type="Sky" id="sky"]
sky_material = SubResource("sky_mat")

[sub_resource type="Environment" id="env"]
background_mode = 2
sky = SubResource("sky")
ambient_light_source = 3
ambient_light_energy = 0.35
tonemap_mode = 2

