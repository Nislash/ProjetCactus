; Les 4 markers C6-C9 dans les petites salles sont retirés pour M2 (training
; pickups) : les petites salles sont les "salles de loot" où on récupère les
; gemmes en sécurité. Les ennemis cachés dedans gênaient le ramassage.
; À ré-ajouter quand on aura un système de spawn dynamique par type de salle.

; ─── PICKUPS : 4 gemmes (1 par école) dans les petites salles annexes ──
; N=Feu, S=Glace, E=Foudre, W=Poison — pédagogique : chaque salle = un
; élément distinct.
[node name="Pickups" type="Node3D" parent="."]

[node name="GemFireN" parent="Pickups" instance=ExtResource("100_firepickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 48)

[node name="GemIceS" parent="Pickups" instance=ExtResource("101_icepickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, -48)

[node name="GemThunderE" parent="Pickups" instance=ExtResource("102_thunderpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 48, 1.2, 0)

[node name="GemPoisonW" parent="Pickups" instance=ExtResource("103_poisonpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -48, 1.2, 0)

; ─── WEAPON PICKUPS au spawn area : Pistolet + Épée ──────────
; Le joueur ramasse l'arme de son choix au start. Pas d'arme = pas de
; tir (cf player_controller._update_shooting). Pickup persistant : on
; peut revenir changer d'arme entre 2 vies.
[node name="WeaponPickups" type="Node3D" parent="."]

[node name="PistolPickup" parent="WeaponPickups" instance=ExtResource("300_wpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0.2, -25)
weapon_kind = &"pistol"
display_name = "Pistolet"
indicator_color = Color(0.9, 0.3, 0.25, 1)

[node name="MeleePickup" parent="WeaponPickups" instance=ExtResource("300_wpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 0.2, -25)
weapon_kind = &"melee"
display_name = "Épée"
indicator_color = Color(0.85, 0.85, 0.95, 1)

; ============================================================
; PUZZLE LEVIER → PORTE CACHÉE → CAVE
;
; Levier dans le coin NE de SmallRoomN (Z=51.5).
; Quand activé, ouvre une porte CAMOUFLÉE dans le mur Est de SmallRoomS
; (à l'autre bout de la map, Z=-48). Le joueur doit explorer pour
; découvrir ce qui s'est ouvert.
;
; Derrière la porte cachée : escalier descendant 4 marches (entouré de
; murs anti-chute) → cave 10×10 à Y=-4 avec lampe verte signature.
; ============================================================

; Levier dans coin NE de SmallRoomN (jaune-or, visible — il indique au
; joueur qu'il y a un mécanisme à activer)
[node name="SecretLever" parent="." instance=ExtResource("200_lever")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4, 0.2, 51.5)
lever_group = &"cave_door_s"

; Porte CACHÉE dans le mur Est de SmallRoomS (X=5, Z=-48). Rotation 90° Y
; pour orientation N-S. Material gris-clair pour matcher les murs autour
; (le joueur ne voit pas la porte tant qu'elle est fermée).
[node name="SecretDoor" parent="." instance=ExtResource("201_door")]
transform = Transform3D(-4.371139e-08, 0, 1, 0, 1, 0, -1, 0, -4.371139e-08, 5, 2, -48)
lever_group = &"cave_door_s"
override_material = SubResource("mat_wall_hidden")

; Escalier descendant entre SmallRoomS (X=5, Z=-48) et cave (X=10), descend Y=0 → Y=-4
