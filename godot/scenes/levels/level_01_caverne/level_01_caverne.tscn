; ============================================================================
; STAIRS DOWN — RoomEntry (Y=0) → Hall (Y=-4), via slope going +Z
; Slope is 9m long over -4m drop ≈ 24° angle (safe < 45°)
; ============================================================================
[node name="StairsDown1" type="StaticBody3D" parent="."]
; Rotation around X axis : tan = -4 / 9 → angle ≈ -24°
; Transform3D: rotation_x ≈ -0.42rad. cos≈0.91, sin≈0.41
; Row1=(1,0,0), Row2=(0,cos,-sin)=(0,0.91,-0.41), Row3=(0,sin,cos)=(0,0.41,0.91)
; Godot Transform3D format is column-major: c0,c1,c2,c3 (each Vector3)
; T3D(c0x,c0y,c0z, c1x,c1y,c1z, c2x,c2y,c2z, originX,originY,originZ)
transform = Transform3D(1, 0, 0, 0, 0.91, 0.41, 0, -0.41, 0.91, 0, -2, 10.5)
